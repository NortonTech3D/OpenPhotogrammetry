FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    gnupg \
    ninja-build \
    python3 \
    python3-pip \
    software-properties-common \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN wget -qO- https://repositories.intel.com/gpu/intel-graphics.key | gpg --dearmor > /usr/share/keyrings/intel-graphics.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/intel-graphics.gpg] https://repositories.intel.com/gpu/ubuntu jammy client" > /etc/apt/sources.list.d/intel-gpu.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      intel-opencl-icd \
      intel-level-zero-gpu \
      level-zero \
      clinfo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/OpenPhotogrammetry

COPY . /workspace/OpenPhotogrammetry

RUN pip3 install --no-cache-dir pyopf requests OpenImageIO

CMD ["bash"]
